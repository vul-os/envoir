{
  "name": "envoir",
  "private": true,
  "version": "0.0.0",
  "description": "Envoir monorepo tooling. See docs/SCREENSHOTS.md for the screenshotter. The WASM sync binding MOVED to the KOTVA repo (crates/kotva-sync-wasm there); its npm build and `node --test` parity suite moved with it.",
  "type": "module",
  "scripts": {
    "screenshotter": "node docs/capture-screenshots.mjs && node scripts/sync-site-screens.mjs",
    "sync-site-screens": "node scripts/sync-site-screens.mjs",
    "docs:sync": "node scripts/sync-site-docs.mjs",
    "docs:sync:check": "node scripts/sync-site-docs.mjs --check",
    "test:client": "node --test 'client/test/**/*.test.ts'",
    "typecheck:client": "tsc --noEmit -p client/tsconfig.json",
    "typecheck:console": "tsc --noEmit -p console/tsconfig.json",
    "typecheck:superadmin": "tsc --noEmit -p superadmin/tsconfig.json",
    "typecheck:status": "tsc --noEmit -p status/tsconfig.json",
    "lint": "eslint .",
    "check:lint-config": "node scripts/check-lint-config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
